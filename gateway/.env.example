# =============================================================================
# OpenClaw Gateway Configuration
# =============================================================================
# Copy this file to .env and fill in the required values.

# --- Server ---
HOST=0.0.0.0
PORT=8080

# --- Database (Required) ---
DATABASE_URL=postgres://openclaw:openclaw@localhost:5432/openclaw

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379

# --- LLM Provider API Keys ---
OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GITHUB_COPILOT_API_KEY=your-github-copilot-key

# --- Routing ---
DEFAULT_COST_PROFILE=balanced
# Cost profiles: budget | balanced | premium | performance

# --- Cache ---
CACHE_TTL_SECONDS=3600
MAX_CACHE_ENTRIES=10000

# --- Pricing ---
PRICING_SYNC_INTERVAL_SECONDS=3600

# --- Dashboard ---
DASHBOARD_URL=http://localhost:3000

# --- Logging ---
RUST_LOG=openclaw_gateway=info,actix_web=info,sqlx=warn
